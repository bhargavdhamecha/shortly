# Copy to .env.dev for local runs. Copy to .env.prod and replace every local
# value with deployment-specific settings before using the production task.

# Shortener database (matches shortner/docker-compose.yml for local development)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=shortner
DB_USERNAME=user
DB_PASSWORD=password

# Shortener Redis cache and limiter
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# Gateway Redis rate-limit store. Use rediss:// for a TLS-enabled endpoint.
GATEWAY_REDIS_URI=redis://localhost:6380

# Shortener public URL and Snowflake identity
APP_BASE_URL=http://localhost:8080
SNOWFLAKE_HOSTNAME=localhost
SNOWFLAKE_DATACENTER_ID=0
SNOWFLAKE_MACHINE_IDS=localhost=0

# Optional Actuator listener settings
MANAGEMENT_PORT=8082
MANAGEMENT_BIND_ADDRESS=127.0.0.1
